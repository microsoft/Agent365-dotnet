<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Microsoft.Agents.A365.Sidecar</AssemblyName>
    <RootNamespace>Microsoft.Agents.A365.Sidecar</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- NuGet Package Properties -->
    <IsPackable>false</IsPackable>
    <Title>Microsoft Agent 365 Sidecar</Title>
    <Description>Language-agnostic sidecar process that exposes Agent365 SDK capabilities over standard protocols (HTTP REST + OTLP) for agents built in any programming language.</Description>
    <Summary>Microsoft Agent 365 Sidecar - Language-agnostic companion process</Summary>
    <Product>Microsoft Agent 365 Sidecar</Product>
    <PackageTags>Microsoft;A365;Sidecar;Agents;AI;OTLP;MCP</PackageTags>
    <!-- Self-contained publishing -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.Agents.A365.Sidecar.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Configuration -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- Agents SDK -->
    <PackageReference Include="Microsoft.Agents.Builder" />
    <PackageReference Include="Microsoft.Agents.Hosting.AspNetCore" />
    <!-- OpenTelemetry -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <!-- Auth -->
    <PackageReference Include="Azure.Identity" />
    <!-- JSON -->
    <PackageReference Include="System.Text.Json" />
    <!-- Source Link Support -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <!-- Internal project references -->
    <ProjectReference Include="..\..\Observability\Runtime\Microsoft.Agents.A365.Observability.Runtime.csproj" />
    <ProjectReference Include="..\..\Tooling\Core\Microsoft.Agents.A365.Tooling.csproj" />
    <ProjectReference Include="..\..\Notification\Microsoft.Agents.A365.Notifications\Microsoft.Agents.A365.Notifications.csproj" />
    <ProjectReference Include="..\..\Runtime\Core\Microsoft.Agents.A365.Runtime.csproj" />
  </ItemGroup>
</Project>

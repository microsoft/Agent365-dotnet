{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "A365Sidecar": {
    "Agent": {
      "Id": "",
      "Name": "Agent365 Sidecar"
    },
    "Tenant": {
      "ExtractFrom": "config"
    },
    "Auth": {
      "Mode": "client-credentials",
      "ClientId": "",
      "ClientSecret": "",
      "TenantId": ""
    },
    "Messaging": {
      "Enabled": true,
      "CustomerWebhook": "http://localhost:8080/agent/turn",
      "Streaming": {
        "Enabled": true,
        "TimeoutSeconds": 30
      }
    },
    "Observability": {
      "Enabled": true,
      "OtlpGrpcPort": 4317,
      "OtlpHttpPort": 4318,
      "ExporterDomain": "agent365.svc.cloud.microsoft"
    },
    "Tooling": {
      "Enabled": true,
      "GatewayEndpoint": ""
    },
    "Notifications": {
      "Enabled": true
    },
    "Server": {
      "Port": 5365,
      "BindAddress": "127.0.0.1"
    }
  }
}

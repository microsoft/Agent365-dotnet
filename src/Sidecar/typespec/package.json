{
  "name": "a365-sidecar-typespec",
  "version": "1.0.0",
  "description": "TypeSpec definitions for the Agent365 Sidecar API",
  "private": true,
  "scripts": {
    "build": "tsp compile .",
    "watch": "tsp compile . --watch",
    "format": "tsp format **/*.tsp"
  },
  "dependencies": {
    "@typespec/compiler": "latest",
    "@typespec/http": "latest",
    "@typespec/rest": "latest",
    "@typespec/openapi3": "latest",
    "@typespec/versioning": "latest"
  }
}

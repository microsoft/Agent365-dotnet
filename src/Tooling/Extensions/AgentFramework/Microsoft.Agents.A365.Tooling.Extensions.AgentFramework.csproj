<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.Agents.A365.Tooling.Extensions.AgentFramework</AssemblyName>
    <RootNamespace>Microsoft.Agents.A365.Tooling.Extensions.AgentFramework</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Package Properties -->
    <PackageId>Microsoft.Agents.A365.Tooling.Extensions.AgentFramework</PackageId>
    <Title>Microsoft Agent 365 Agent Framework Tooling SDK</Title>
    <Description>A .NET SDK that integrates Microsoft Agent 365 with Agent Framework, providing tooling functionalities.</Description>
    <Summary>Microsoft Agent 365 Agent Framework Tooling Integration - Provides a way to add Agent 365 MCP Servers</Summary>
    <Product>Microsoft Agent 365 Agent Framework Tooling SDK</Product>
    <PackageTags>Microsoft;A365AgentFramework;OpenTelemetry;AI;Agents;Tooling</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure AI and Extensions AI packages -->
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.AzureAIInference" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    
    <!-- Source Link Support -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="Microsoft.Agents.Authentication.Msal" />
    <PackageReference Include="Microsoft.Agents.Hosting.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Microsoft.Agents.A365.Tooling.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.Agents.A365.Tooling.SemanticKernel</AssemblyName>
    <RootNamespace>Microsoft.Agents.A365.Tooling.SemanticKernel</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    
    <!-- NuGet Package Properties -->
    <PackageId>Microsoft.Agents.A365.Tooling.SemanticKernel</PackageId>
    <Title>Microsoft Kairo SemanticKernel Integration</Title>
    <Description>A .NET SDK that integrates Microsoft Kairo with SemanticKernel, providing tooling functionalities.</Description>
    <Summary>Microsoft Kairo SemanticKernel Tooling Integration - Provides a way to add A365 MCP Servers</Summary>
    <Product>Microsoft Agents A365 SDK SemanticKernel Tooling Integration</Product>
    <PackageTags>Microsoft;Kairo;SemanticKernel;OpenTelemetry;AI;Agents;Tooling</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Core" />
    <!-- Source Link Support -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="Microsoft.Agents.Authentication.Msal" />
    <PackageReference Include="Microsoft.Agents.Hosting.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Observability\Extensions\SemanticKernel\Microsoft.Agents.A365.Observability.Extensions.SemanticKernel.csproj" />
    <ProjectReference Include="..\..\..\Runtime\Core\Microsoft.Agents.A365.Runtime.csproj" />
    <ProjectReference Include="..\..\Core\Microsoft.Agents.A365.Tooling.csproj" />
  </ItemGroup>
</Project>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.Agents.A365.Tooling.Extensions.SemanticKernel</AssemblyName>
    <RootNamespace>Microsoft.Agents.A365.Tooling.Extensions.SemanticKernel</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    
    <!-- NuGet Package Properties -->
    <PackageId>Microsoft.Agents.A365.Tooling.Extensions.SemanticKernel</PackageId>
    <Title>Microsoft Agent 365 Semantic Kernel Tooling SDK</Title>
    <Description>A .NET SDK that integrates Microsoft Agent 365 with Semantic Kernel, providing tooling functionalities.</Description>
    <Summary>Microsoft Agent 365 Semantic Kernel Tooling Integration - Provides a way to add Agent 365 MCP Servers</Summary>
    <Product>Microsoft Agent 365 Semantic Kernel Tooling SDK</Product>
    <PackageTags>Microsoft;A365SemanticKernel;OpenTelemetry;AI;Agents;Tooling</PackageTags>
    <!-- Suppress NU5104: ModelContextProtocol.Core stable release is not yet available -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Core" />
    <!-- Source Link Support -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="Microsoft.Agents.Authentication.Msal" />
    <PackageReference Include="Microsoft.Agents.Hosting.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Microsoft.Agents.A365.Tooling.csproj" />
  </ItemGroup>

</Project>



<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>Microsoft.Agents.A365.Tooling.Extensions.AzureAIFoundry</AssemblyName>
		<RootNamespace>Microsoft.Agents.A365.Tooling.Extensions.AzureAIFoundry</RootNamespace>
		<TargetFramework>net8.0</TargetFramework>
		<LangVersion>latest</LangVersion>

		<!-- NuGet Package Properties -->
		<PackageId>Microsoft.Agents.A365.Tooling.Extensions.AzureAIFoundry</PackageId>
		<Title>Microsoft Agent 365 Azure AI Foundry Tooling SDK</Title>
		<Description>A .NET SDK that integrates Microsoft Agent 365 with Azure AI Foundry, providing tooling functionalities.</Description>
		<Summary>Microsoft Agent 365 Azure AI Foundry Tooling Integration - Provides a way to add Agent 365 MCP Servers</Summary>
		<Product>Microsoft Agent 365 Azure AI Foundry Tooling SDK</Product>
		<PackageTags>Microsoft;A365AzureAI;OpenTelemetry;AI;Agents;Tooling</PackageTags>
		<!-- Suppress NU5104: Azure.AI.Agents.Persistent stable (1.1.0) is older than the beta we depend on (1.2.0-beta.4); downgrading would break APIs -->
		<NoWarn>$(NoWarn);NU5104</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- Azure AI Foundry related package -->
		<PackageReference Include="Azure.AI.Agents.Persistent" />

		<!-- Source Link Support -->
		<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
		<PackageReference Include="ModelContextProtocol.Core" />
		<PackageReference Include="Microsoft.Agents.Authentication.Msal" />
		<PackageReference Include="Microsoft.Agents.Hosting.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Core\Microsoft.Agents.A365.Tooling.csproj" />
	</ItemGroup>
</Project>

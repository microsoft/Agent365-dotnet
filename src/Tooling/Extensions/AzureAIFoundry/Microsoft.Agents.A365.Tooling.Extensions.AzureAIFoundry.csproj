<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>Microsoft.Agents.A365.Tooling.Extensions.AzureAIFoundry</AssemblyName>
		<RootNamespace>Microsoft.Agents.A365.Tooling.Extensions.AzureAIFoundry</RootNamespace>
		<TargetFramework>net8.0</TargetFramework>
		<LangVersion>latest</LangVersion>

		<!-- NuGet Package Properties -->
		<PackageId>Microsoft.Agents.A365.Tooling.Extensions.AzureAIFoundry</PackageId>
		<Title>Microsoft Agents A365 Azure AI Foundry Integration</Title>
		<Description>A .NET SDK that integrates Microsoft Agents A365 with Azure AI Foundry, providing tooling functionalities.</Description>
		<Summary>Microsoft Agents A365 Azure AI Foundry Tooling Integration - Provides a way to add A365 MCP Servers</Summary>
		<Product>Microsoft Agents A365 SDK Azure AI Foundry Tooling Integration</Product>
		<PackageTags>Microsoft;A365AzureAI;OpenTelemetry;AI;Agents;Tooling</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<!-- Azure AI Foundry related package -->
		<PackageReference Include="Azure.AI.Agents.Persistent" />

		<!-- Source Link Support -->
		<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
		<PackageReference Include="ModelContextProtocol.Core" />
		<PackageReference Include="Microsoft.Agents.Authentication.Msal" />
		<PackageReference Include="Microsoft.Agents.Hosting.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Core\Microsoft.Agents.A365.Tooling.csproj" />
	</ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.Agents.A365.Tooling.LocalMcp</AssemblyName>
    <RootNamespace>Microsoft.Agents.A365.Tooling.LocalMcp</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- NuGet Package Properties -->
    <PackageId>Microsoft.Agents.A365.Tooling.LocalMcp</PackageId>
    <Title>Microsoft Agent 365 Local MCP Proxy</Title>
    <Description>Microsoft Agent 365 Local MCP Proxy - provides WNS-based communication with desktop MCP servers for local tool access.</Description>
    <Summary>Microsoft Agent 365 Local MCP Proxy for Windows desktop MCP server communication</Summary>
    <Product>Microsoft Agent 365 Local MCP SDK</Product>
    <PackageTags>Microsoft;Agent365;A365;Tooling;MCP;LocalMCP;WNS;AI;Agents</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.WebSockets" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- Source Link Support -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Microsoft.Agents.A365.Tooling.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>

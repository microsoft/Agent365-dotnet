<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.Agents.A365.Runtime</AssemblyName>
    <RootNamespace>Microsoft.Agents.A365.Runtime</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <!-- NuGet Package Properties -->
    <PackageId>Microsoft.Agents.A365.Runtime</PackageId>
    <Title>Microsoft Agent 365 Runtime SDK</Title>
    <Description>Runtime utilities for Microsoft Agent 365 SDK, providing HttpContext-based tenant and worker ID extraction for multi-tenant agent applications.</Description>
    <Summary>Microsoft Agent 365 Runtime SDK - Tenant context helpers for web applications</Summary>
    <Product>Microsoft Agent 365 Runtime SDK</Product>
    <PackageTags>Microsoft;A365AspNetCore;MultiTenant;HttpContext;Web;AI;Agents</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core dependencies -->
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
    <!-- Agents SDK dependencies -->
    <PackageReference Include="Microsoft.Agents.Authentication.Msal" />
    <PackageReference Include="Microsoft.Agents.Hosting.AspNetCore" />
    <!-- Source Link Support -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
  <!-- Exclude test files from main project compilation -->
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <None Include="Tests/**/*.cs" />
  </ItemGroup>
</Project>

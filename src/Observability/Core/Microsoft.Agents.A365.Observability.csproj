<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.Agents.A365.Observability</AssemblyName>
    <RootNamespace>Microsoft.Agents.A365.Observability</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <!-- NuGet Package Properties -->
    <PackageId>Microsoft.Agents.A365.Observability</PackageId>
    <Title>Microsoft Agents A365 SDK Observability Common</Title>
    <Description>Common observability components for Microsoft Agents A365 SDK, providing base OpenTelemetry tracing and monitoring functionality for AI agents and tools.</Description>
    <Summary>Microsoft Agents A365 SDK Observability Common - Base tracing and monitoring components</Summary>
    <Product>Microsoft Agents A365 SDK Observability Common</Product>
    <PackageTags>Microsoft;Agents;A365;Observability;OpenTelemetry;AI;Agents;Tracing;Monitoring;Telemetry</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="OpenAI\**" />
    <Compile Remove="Microsoft.Agents.A365.Observability.Tests\**" />
    <Compile Remove="SemanticKernel\**" />
    <EmbeddedResource Remove="OpenAI\**" />
    <EmbeddedResource Remove="Microsoft.Agents.A365.Observability.Tests\**" />
    <EmbeddedResource Remove="SemanticKernel\**" />
    <None Remove="OpenAI\**" />
    <None Remove="Microsoft.Agents.A365.Observability.Tests\**" />
    <None Remove="SemanticKernel\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Azure.Monitor.Ingestion" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Runtime\Core\Microsoft.Agents.A365.Runtime.csproj" />
    <ProjectReference Include="..\Runtime\Microsoft.Agents.A365.Observability.Runtime.csproj" />
  </ItemGroup>
</Project>

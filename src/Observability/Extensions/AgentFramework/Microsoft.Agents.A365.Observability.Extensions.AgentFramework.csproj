<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.Agents.A365.Observability.Extensions.AgentFramework</AssemblyName>
    <RootNamespace>Microsoft.Agents.A365.Observability.Extensions.AgentFramework</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <!-- NuGet Package Properties -->
    <PackageId>Microsoft.Agents.A365.Observability.Extensions.AgentFramework</PackageId>
    <Title>Microsoft Agent 365 Agent Framework Observability SDK</Title>
    <Description>Agent Framework observability integration for Microsoft Agent 365 SDK, providing tracing and monitoring for Agent Framework operations.</Description>
    <Summary>Microsoft Agent 365 Agent Framework Observability Integration - Tracing and monitoring for Agent Framework agents</Summary>
    <Product>Microsoft Agent 365 Agent Framework Observability SDK</Product>
    <PackageTags>Microsoft;Agents;A365;Observability;AgentFramework;OpenTelemetry;AI;Agents;Tracing;Monitoring</PackageTags>
  </PropertyGroup>
    
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Runtime\Microsoft.Agents.A365.Observability.Runtime.csproj" />
  </ItemGroup>
</Project>

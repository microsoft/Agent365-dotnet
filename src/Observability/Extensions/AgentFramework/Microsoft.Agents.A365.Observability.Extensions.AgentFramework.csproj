<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.Agents.A365.Observability.Extensions.AgentFramework</AssemblyName>
    <RootNamespace>Microsoft.Agents.A365.Observability.Extensions.AgentFramework</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <!-- NuGet Package Properties -->
    <PackageId>Microsoft.Agents.A365.Observability.Extensions.AgentFramework</PackageId>
    <Title>Microsoft Agents A365 SDK Observability AgentFramework</Title>
    <Description>AgentFramework observability integration for Microsoft Agents A365 SDK, providing tracing and monitoring for AgentFramework operations.</Description>
    <Summary>Microsoft Agents A365 SDK Observability AgentFramework - Tracing and monitoring for AgentFramework agents</Summary>
    <Product>Microsoft Agents A365 SDK Observability AgentFramework</Product>
    <PackageTags>Microsoft;Agents;A365;Observability;AgentFramework;OpenTelemetry;AI;Agents;Tracing;Monitoring</PackageTags>
  </PropertyGroup>
    
  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>
  <ItemGroup>    <ProjectReference Include="..\..\Core\Microsoft.Agents.A365.Observability.csproj" />
  </ItemGroup>
</Project>

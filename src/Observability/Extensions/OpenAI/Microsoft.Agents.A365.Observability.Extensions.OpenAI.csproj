<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.Agents.A365.Observability.Extensions.OpenAI</AssemblyName>
    <RootNamespace>Microsoft.Agents.A365.Observability.Extensions.OpenAI</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <!-- NuGet Package Properties -->
    <PackageId>Microsoft.Agents.A365.Observability.Extensions.OpenAI</PackageId>
    <Title>Microsoft Agent 365 OpenAI Observability SDK</Title>
    <Description>OpenAI observability integration for Microsoft Agent 365 SDK, providing tracing and monitoring for OpenAI operations.</Description>
    <Summary>Microsoft Agent 365 OpenAI Observability Integration - Tracing and monitoring for OpenAI agents</Summary>
    <Product>Microsoft Agent 365 OpenAI Observability SDK</Product>
    <PackageTags>Microsoft;Agents;A365;Observability;OpenAI;OpenTelemetry;AI;Agents;Tracing;Monitoring</PackageTags>
    <!-- Suppress NU5104: Azure.AI.OpenAI stable (2.1.0) is older than the beta we depend on (2.7.0-beta.2); downgrading would break APIs -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.Agents.A365.Observability.Extensions.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Runtime\Microsoft.Agents.A365.Observability.Runtime.csproj" />
  </ItemGroup>
</Project>




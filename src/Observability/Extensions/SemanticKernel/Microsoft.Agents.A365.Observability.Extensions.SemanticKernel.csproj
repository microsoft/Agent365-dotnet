<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.Agents.A365.Observability.SemanticKernel</AssemblyName>
    <RootNamespace>Microsoft.Agents.A365.Observability.SemanticKernel</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <!-- NuGet Package Properties -->
    <PackageId>Microsoft.Agents.A365.Observability.SemanticKernel</PackageId>
    <Title>Microsoft Agents A365 SDK Observability SemanticKernel</Title>
    <Description>SemanticKernel observability integration for Microsoft Agents A365 SDK, providing automatic tracing for ChatCompletionAgent operations.</Description>
    <Summary>Microsoft Agents A365 SDK Observability SemanticKernel - Automatic tracing for SemanticKernel agents</Summary>
    <Product>Microsoft Agents A365 SDK Observability SemanticKernel</Product>
    <PackageTags>Microsoft;Kairo;Observability;SemanticKernel;OpenTelemetry;AI;Agents;Tracing;Monitoring</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" />
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Core" />
    <!-- Source Link Support -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
      <ProjectReference Include="..\..\Core\Microsoft.Agents.A365.Observability.csproj" />
  </ItemGroup>
</Project>
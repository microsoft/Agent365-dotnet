<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.Agents.A365.Observability.Extensions.SemanticKernel</AssemblyName>
    <RootNamespace>Microsoft.Agents.A365.Observability.Extensions.SemanticKernel</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <!-- NuGet Package Properties -->
    <PackageId>Microsoft.Agents.A365.Observability.Extensions.SemanticKernel</PackageId>
    <Title>Microsoft Agent 365 Semantic Kernel Observability SDK</Title>
    <Description>Semantic Kernel observability integration for Microsoft Agent 365 SDK, providing automatic tracing for ChatCompletionAgent operations.</Description>
    <Summary>Microsoft Agent 365 Semantic Kernel Observability Integration - Automatic tracing for Semantic Kernel agents</Summary>
    <Product>Microsoft Agent 365 Semantic Kernel Observability SDK</Product>
    <PackageTags>Microsoft;A365Observability;SemanticKernel;OpenTelemetry;AI;Agents;Tracing;Monitoring</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" />
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Core" />
    <!-- Source Link Support -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Microsoft.Agents.A365.Observability.csproj" />
  </ItemGroup>
</Project>

root = true

# Analyzer severity recommendations for Microsoft.Agents.A365.DevTools.Analyzer.SemanticKernel
# Enforce governance rules as errors by default
[*.cs]
# Kernel retrieval before build
dotnet_diagnostic.A365SK0001.severity = error
# Kernel direct access
dotnet_diagnostic.A365SK0002.severity = error
# Unsafe plugin import
dotnet_diagnostic.A365SK0003.severity = error
# Tenant/Worker ID access
dotnet_diagnostic.A365SK0004.severity = error
# Chat completion service registration
dotnet_diagnostic.A365SK0005.severity = error
# Governance enforcement in endpoints
dotnet_diagnostic.A365SK0006.severity = error

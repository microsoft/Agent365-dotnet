<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- Explicitly pack the analyzer DLL and XML into analyzers/dotnet/cs/ -->
    <None Include="bin\Release\netstandard2.0\Microsoft.Agents.A365.DevTools.Analyzer.OpenAI.dll" Pack="true" PackagePath="analyzers/dotnet/cs/Microsoft.Agents.A365.DevTools.Analyzer.OpenAI.dll" Condition="Exists('bin\Release\netstandard2.0\Microsoft.Agents.A365.DevTools.Analyzer.OpenAI.dll')" />
    <None Include="bin\Release\netstandard2.0\Microsoft.Agents.A365.DevTools.Analyzer.OpenAI.xml" Pack="true" PackagePath="analyzers/dotnet/cs/Microsoft.Agents.A365.DevTools.Analyzer.OpenAI.xml" Condition="Exists('bin\Release\netstandard2.0\Microsoft.Agents.A365.DevTools.Analyzer.OpenAI.xml')" />
  </ItemGroup>
  <PropertyGroup>
    <AssemblyName>Microsoft.Agents.A365.DevTools.Analyzer.OpenAI</AssemblyName>
    <RootNamespace>Microsoft.Agents.A365.DevTools.Analyzer.OpenAI</RootNamespace>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Analyzer-specific properties -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <DevelopmentDependency>false</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Explicitly mark this package as an Analyzer package for consumers/feeds -->
    <PackageType>Analyzer</PackageType>
    <!-- NuGet Package Properties -->
    <PackageId>Microsoft.Agents.A365.DevTools.Analyzer.OpenAI</PackageId>
    <Title>Microsoft Agents A365 OpenAI Governance Analyzers</Title>
    <Description>Roslyn analyzers for enforcing governance rules and best practices in Microsoft Agents A365 OpenAI-based multi-tenant AI agent projects. Ensures proper client access patterns, multi-tenant isolation, and secure coding practices.</Description>
    <Summary>Governance analyzers for Microsoft Agents A365 OpenAI projects - enforces multi-tenant security and coding standards</Summary>
    <Product>Microsoft Agents A365 SDK OpenAI Analyzers</Product>
    <PackageTags>Microsoft;Agents;A365;OpenAI;Analyzers;Roslyn;Governance;MultiTenant;Security;CodeAnalysis;AI;Agents</PackageTags>
    <!-- Suppress warnings for analyzer projects -->
    <NoWarn>$(NoWarn);CS1591;CS1587;CS8602;CS8603;CS8604;CS8631</NoWarn>
    <!-- Allow files that start with '.' to be included in the package (e.g., .editorconfig) -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- Use explicit packaging entries instead of relying on IncludeBuildOutput heuristics -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Ensure this project is considered packable by the SDK -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core Roslyn packages for analyzers -->
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="System.Composition" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <None Include=".editorconfig" Pack="true" PackagePath="contentFiles/any/any/.editorconfig" Condition="Exists('.editorconfig')" />
    <None Include="tools/install.ps1" Pack="true" PackagePath="tools/install.ps1" Condition="Exists('tools/install.ps1')" />
    <None Include="tools/uninstall.ps1" Pack="true" PackagePath="tools/uninstall.ps1" Condition="Exists('tools/uninstall.ps1')" />
  </ItemGroup>
  <ItemGroup>
    <!-- Add the analyzer assembly to the Analyzer items so MSBuild sees it during compilation and to make analyzer tooling aware of the artifact. -->
    <Analyzer Include="bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).dll" Condition="Exists('bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).dll')" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude test files from the main analyzer project compilation -->
    <Compile Remove="Tests\**\*" />
    <None Remove="Tests\**\*" />
    <EmbeddedResource Remove="Tests\**\*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only include the _._ placeholder in lib/netstandard2.0 for NuGet analyzer-only package compliance -->
    <None Include="lib\netstandard2.0\_._" Pack="true" PackagePath="lib/netstandard2.0/_._" Condition="Exists('lib\netstandard2.0\_._')" />
  </ItemGroup>
</Project>